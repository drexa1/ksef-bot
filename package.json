{
    "name": "ksef-bot",
    "version": "1.0.0",
    "description": "Invoicing automation for KSeF",
    "keywords": [
        "KSeF",
        "Invoicing",
        "Automation",
        "Poland"
    ],
    "homepage": "https://github.com/drexa1/ksef-bot#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/drexa1/ksef-bot.git"
    },
    "author": "drexa1",
    "scripts": {
        "db:dev:teardown": "wrangler d1 execute ksef-bot --config wrangler.worker.toml --local --file=db/teardown.sql",
        "db:dev:create": "wrangler d1 execute ksef-bot --config wrangler.worker.toml --local --file=db/schema.sql",
        "db:dev:recreate": "npm run db:local:teardown && npm run db:local:create",
        "⚠ db:prod:teardown": "wrangler d1 execute ksef-bot --remote --file=db/teardown.sql",
        "⚠ db:prod:create": "wrangler d1 execute ksef-bot  --remote --file=db/schema.sql",

        "client:dev:build": "vite build --mode development",
        "client:dev:run": "npm run client:local:build && vite --port 3000",
        "client:dev:test": "vitest",
        "client:prod:build": "vite build --mode production",

        "api:tests:wait": "wait-on http://localhost:3001 && npm run api:tests:bruno",
        "api:tests:bruno": "cd tests/api && bru run -r --env dev --sandbox dev",
        "api:tests:dev": "npm run db:local:recreate && concurrently -k npm:worker:dev npm:api:tests:wait",
        "api:tests:ci": "bash .github/scripts/api-tests-ci.sh",

        "worker:dev:run": "npm run client:build && wrangler dev --config wrangler.worker.toml --local --port 3001 --inspector-port 9999",
        "worker:prod:deploy": "npm run client:build && wrangler deploy --config wrangler.worker.toml",
        "worker:prod:logs": "wrangler tail ksef-bot"
    },
    "dependencies": {
        "@sentry/cli": "latest",
        "asn1js": "latest",
        "concurrently": "latest",
        "fast-xml-builder": "latest",
        "fast-xml-parser": "latest",
        "p-retry": "latest",
        "pkijs": "latest",
        "vite": "latest"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "latest",
        "@sentry/cloudflare": "latest",
        "@sentry/tracing": "latest",
        "@types/bootstrap": "latest",
        "@usebruno/cli": "latest",
        "glob": "latest",
        "typescript": "latest",
        "vitest": "latest",
        "wait-on": "latest",
        "wasm-pack": "latest",
        "wrangler": "latest"
    }
}
