get {
    url: {{baseUrl}}/gov/contractors?nip=1234567890
}
headers {
    Accept: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("For invalid NIP entrypoint lookup should fail", function() {
        expect(res.status).to.equal(400);
        expect(res.body.error).to.equal("Contractor not found");
    })
}