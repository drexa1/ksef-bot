get {
    url: {{baseUrl}}/app/contractors?id={{contractor2Id}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created contractor2", function() {
        console.info(res.body);
        expect(res.body.id).to.equal(bru.getCollectionVar("contractor2Id"));
    })
}