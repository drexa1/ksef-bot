put {
    url: {{baseUrl}}/app/taxes
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
script:pre-request {
    req.setBody(JSON.stringify({ from: "missing", to: "missing", notes: "nevermind" }));
}
tests {
    test("Update a non-existing tax record raise invalid dates", function() {
        expect(res.status).to.equal(400);
    })
}