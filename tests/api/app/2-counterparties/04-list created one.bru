get {
    url: {{baseUrl}}/app/counterparties?id={{counterparty1Id}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created counterparty one", function() {
        console.info(res.body);
        expect(res.body.id).to.equal(bru.getCollectionVar("counterparty1Id"));
    })
}