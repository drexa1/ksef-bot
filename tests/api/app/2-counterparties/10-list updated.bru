get {
    url: {{baseUrl}}/app/counterparties?id={{counterparty1Id}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List a recently updated counterparty should show the edition", function() {
        console.info(res.body);
        expect(res.body.name).to.equal("edited");
    })
}