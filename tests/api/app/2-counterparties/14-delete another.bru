delete {
    url: {{baseUrl}}/app/counterparties?id={{counterparty2Id}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("Delete a recently created user counterparty should succeed", function() {
        expect(res.body.id).to.equal(bru.getCollectionVar("counterparty2Id"));
    })
}