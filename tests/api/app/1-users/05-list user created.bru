get {
    url: {{baseUrl}}/app/users?email={{userEmail}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created user", function() {
        console.info(res.body);
        expect(res.body.email).to.equal(bru.getCollectionVar("userEmail"));
    })
}