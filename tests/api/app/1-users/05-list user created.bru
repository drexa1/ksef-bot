get {
    url: {{baseUrl}}/app/users?id={{userId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created user", function() {
        console.info(res.body);
        expect(res.body.id).to.equal(bru.getCollectionVar("userId"));
    })
}