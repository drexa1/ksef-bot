put {
    url: {{baseUrl}}/app/users
    body: json
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
body:json {
    email: "missing"
    firstName: "nevermind"
}
tests {
    test("Update a missing user should fail", function() {
        expect(res.status).to.equal(404);
    })
}