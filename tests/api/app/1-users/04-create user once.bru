post {
    url: {{baseUrl}}/app/users
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
script:pre-request {
    const fs = require("fs");
    const body = fs.readFileSync("../testresources/users/user-1.json", "utf8");
    req.setBody(JSON.parse(body));
}
tests {
    test("Create a user for the first time should succeed", function() {
        expect(res.status).to.equal(201);
    })
}
script:post-response {
    bru.setCollectionVar("userEmail", res.body.email);
}