get {
    url: {{baseUrl}}/app/counterparties?nip={{salesInvoiceCounterpartyId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created buyer counterparty", function() {
        console.info(res.body);
        expect(res.body.nip).to.equal(bru.getCollectionVar("salesInvoiceCounterpartyId"));
    })
}