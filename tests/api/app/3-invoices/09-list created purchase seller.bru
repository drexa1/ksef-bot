get {
    url: {{baseUrl}}/app/counterparties?nip={{purchaseInvoiceSellerId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created seller counterparty", function() {
        console.info(res.body);
        expect(res.body.nip).to.equal(bru.getCollectionVar("purchaseInvoiceSellerId"));
    })
}