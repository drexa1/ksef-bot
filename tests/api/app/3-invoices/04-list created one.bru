get {
    url: {{baseUrl}}/app/invoices?id={{salesInvoiceId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created sales invoice", function() {
        expect(res.body.InvoiceBody.InvoiceNumber).to.equal(bru.getCollectionVar("salesInvoiceId"));
    })
}