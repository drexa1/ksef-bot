get {
    url: {{baseUrl}}/app/customers
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
script:pre-request {
    const customerIds = new Set();
    customerIds.add(bru.getCollectionVar("salesInvoiceCustomerId"));
    bru.setCollectionVar("createdCustomers", JSON.stringify([...customerIds]));
}
tests {
    test("List all customers created are still existing", function() {
        console.info(res.body);
        const createdCustomers = JSON.parse(bru.getCollectionVar("createdCustomers"));
        expect(res.body.length).to.equal(createdCustomers.length);
    })
}