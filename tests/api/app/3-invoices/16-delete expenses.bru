delete {
    url: {{baseUrl}}/app/invoices?id={{expensesInvoiceId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("Delete a recently created expenses invoice should succeed", function() {
        expect(res.body.id).to.equal(bru.getCollectionVar("expensesInvoiceId"));
    })
}