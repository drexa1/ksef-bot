delete {
    url: {{baseUrl}}/app/invoices?id={{salesInvoiceId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("Delete a recently created sales invoice should succeed", function() {
        expect(res.body.id).to.equal(bru.getCollectionVar("salesInvoiceId"));
    })
}