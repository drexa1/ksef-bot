delete {
    url: {{baseUrl}}/app/contractors
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("Delete all customers", function() {
        console.info(res.body);
        const createdContractors = JSON.parse(bru.getCollectionVar("createdContractors"));
        expect(res.body.changes).to.equal(createdContractors.length);
    })
}