get {
    url: {{baseUrl}}/app/customers?nip={{purchaseInvoiceCustomerId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created buyer customer", function() {
        console.info(res.body);
        expect(res.body.error).to.equal("Customer not found");
    })
}