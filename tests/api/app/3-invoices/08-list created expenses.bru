get {
    url: {{baseUrl}}/app/invoices?id={{expensesInvoiceId}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created expenses invoice", function() {
        expect(res.body.InvoiceBody.InvoiceNumber).to.equal(bru.getCollectionVar("expensesInvoiceId"));
    })
}
script:post-response {
     bru.setCollectionVar("expensesInvoiceSellerId", res.body.Seller.IdentificationData.NIP);
     bru.setCollectionVar("expensesInvoiceBuyerId", res.body.Buyer.IdentificationData.NIP);
}