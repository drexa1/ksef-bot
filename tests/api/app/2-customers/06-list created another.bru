get {
    url: {{baseUrl}}/app/customers?id={{customer2Id}}
}
headers {
    Content-Type: application/json
    X-API-Key: {{apiKey}}
}
tests {
    test("List the recently created customer two", function() {
        console.info(res.body);
        expect(res.body.id).to.equal(bru.getCollectionVar("customer2Id"));
    })
}