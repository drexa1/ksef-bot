#@no-redirect
@baseUrl = http://localhost:3001
@apiKey = test
@counterpartyId = 7c4f2d9a-8b31-4e65-a1f7-2d9c6b3e5048

### Delete non-existing counterparty
DELETE {{baseUrl}}/app/counterparties?id=missing
Content-Type: application/json
X-API-Key: {{apiKey}}

### Delete existing counterparty
DELETE {{baseUrl}}/app/counterparties?id={{counterpartyId}}
Content-Type: application/json
X-API-Key: {{apiKey}}