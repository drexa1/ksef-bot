#@no-redirect
@baseUrl = http://localhost:3001
@apiKey = test
@counterpartyId = 7c4f2d9a-8b31-4e65-a1f7-2d9c6b3e5048

### Update existing counterparty
PUT {{baseUrl}}/db/counterparties
Content-Type: application/json
X-API-Key: {{apiKey}}

{
    "id": "{{counterpartyId}}",
    "name": "edited"
}

### Update a missing counterparty
PUT {{baseUrl}}/db/counterparties
Content-Type: application/json
X-API-Key: {{apiKey}}

{
    "id": "missing",
    "name": "nevermind"
}