#@no-redirect
@baseUrl = http://localhost:3001
@apiKey = test
@counterpartyId = counterparty-from-invoice

### Update an existing counterparty
PUT {{baseUrl}}/db/counterparties
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "id": "{{counterpartyId}}",
  "name": "edited"
}

### Update a missing counterparty
PUT {{baseUrl}}/db/counterparties
Content-Type: application/json
X-API-Key: {{apiKey}}

{
  "id": "missing",
  "name": "nevermind"
}