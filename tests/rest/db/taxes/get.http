#@no-redirect
@baseUrl = http://localhost:3001
@apiKey = test
@taxRecordId = 9de76eee-87fe-44b7-adbe-c9c596113aa9

### List all
GET {{baseUrl}}/db/taxes
Content-Type: application/json
X-API-Key: {{apiKey}}

### List non-existing tax record
GET {{baseUrl}}/db/taxes?id=missing
Content-Type: application/json
X-API-Key: {{apiKey}}

### List existing tax record
GET {{baseUrl}}/db/taxes?id={{taxRecordId}}
Content-Type: application/json
X-API-Key: {{apiKey}}