#@no-redirect
@baseUrl = http://localhost:3001
@apiKey = test
@from = 2026/06/01
@to = 2026/08/01

### List for non-existing dates
GET {{baseUrl}}/ksef/sales?from=missing&to=missing
Content-Type: application/json
X-API-Key: {{apiKey}}

### List for existing dates
GET {{baseUrl}}/ksef/sales?from={{from}}&to={{to}}
Content-Type: application/json
X-API-Key: {{apiKey}}