#@no-redirect
@baseUrl = http://localhost:3001
@apiKey = test
@from = 2026/06/01
@to = 2026/08/01

### list for non-existing dates
GET {{baseUrl}}/ksef/expenses?from=missing&to=missing
Content-Type: application/json
X-API-Key: {{apiKey}}

### list for existing dates
GET {{baseUrl}}/ksef/expenses?from={{from}}&to={{to}}
Content-Type: application/json
X-API-Key: {{apiKey}}