{
  "type": "record",
  "name": "KSeFInvoice",
  "namespace": "pl.ksef.fa3",
  "doc": "Polish KSeF FA(3) invoice document.",
  "fields": [
    {
      "name": "Naglowek",
      "aliases": ["Header"],
      "type": {
        "type": "record",
        "name": "Naglowek",
        "doc": "Invoice XML header information.",
        "fields": [
          {
            "name": "KodFormularza",
            "aliases": ["FormCode"],
            "type": {
              "type": "record",
              "name": "KodFormularza",
              "doc": "Invoice form identifier and schema information.",
              "fields": [
                {
                  "name": "value",
                  "aliases": ["value"],
                  "type": "string",
                  "doc": "Form code value, e.g. FA."
                },
                {
                  "name": "kodSystemowy",
                  "aliases": ["systemCode"],
                  "type": "string",
                  "doc": "System identifier of the form, e.g. FA (3)."
                },
                {
                  "name": "wersjaSchemy",
                  "aliases": ["schemaVersion"],
                  "type": "string",
                  "doc": "Schema version used to generate the invoice."
                }
              ]
            }
          },
          {
            "name": "WariantFormularza",
            "aliases": ["FormVariant"],
            "type": "int",
            "doc": "Invoice form variant number."
          },
          {
            "name": "DataWytworzeniaFa",
            "aliases": ["InvoiceCreationDate"],
            "type": "string",
            "doc": "Timestamp when the invoice file was created."
          },
          {
            "name": "SystemInfo",
            "aliases": ["SystemInfo"],
            "type": "string",
            "doc": "Application or system that generated the invoice."
          }
        ]
      }
    },
    {
      "name": "Podmiot1",
      "aliases": ["Seller"],
      "type": {
        "type": "record",
        "name": "Podmiot1",
        "doc": "Seller information.",
        "fields": [
          {
            "name": "DaneIdentyfikacyjne",
            "aliases": ["IdentificationData"],
            "type": {
              "type": "record",
              "name": "SellerIdentification",
              "fields": [
                {
                  "name": "NIP",
                  "aliases": ["NIP"],
                  "type": "string",
                  "doc": "Seller Polish tax identification number."
                },
                {
                  "name": "Nazwa",
                  "aliases": ["Name"],
                  "type": "string",
                  "doc": "Seller name."
                }
              ]
            }
          },
          {
            "name": "Adres",
            "aliases": ["Address"],
            "type": {
              "type": "record",
              "name": "SellerAddress",
              "fields": [
                {
                  "name": "KodKraju",
                  "aliases": ["CountryCode"],
                  "type": "string",
                  "doc": "Seller country code."
                },
                {
                  "name": "AdresL1",
                  "aliases": ["AddressLine1"],
                  "type": "string",
                  "doc": "Seller address formatted as a single line."
                }
              ]
            }
          },
          {
            "name": "DaneKontaktowe",
            "aliases": ["ContactData"],
            "type": [
              "null",
              {
                "type": "record",
                "name": "SellerContact",
                "fields": []
              }
            ],
            "default": null,
            "doc": "Seller contact information."
          }
        ]
      }
    },
    {
      "name": "Podmiot2",
      "aliases": ["Buyer"],
      "type": {
        "type": "record",
        "name": "Podmiot2",
        "doc": "Buyer information.",
        "fields": [
          {
            "name": "DaneIdentyfikacyjne",
            "aliases": ["IdentificationData"],
            "type": {
              "type": "record",
              "name": "BuyerIdentification",
              "fields": [
                {
                  "name": "NIP",
                  "aliases": ["NIP"],
                  "type": "string",
                  "doc": "Buyer Polish tax identification number."
