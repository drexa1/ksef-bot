            "name": "GV",
            "aliases": ["GovernmentUnit"],
            "type": ["null", "int"],
            "default": null,
            "doc": "Indicator identifying government unit status."
          }
        ]
      }
    },
    {
      "name": "Fa",
      "aliases": ["InvoiceBody"],
      "type": {
        "type": "record",
